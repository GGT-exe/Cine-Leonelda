---

interface ProductoBase {
  id: number;
  nombre: string;
  precio: number;
}

interface ProductoIndividual extends ProductoBase {
  imagen: string;
  tipo: 'individual';
}

interface ProductoCombo extends ProductoBase {
  descripcion: string;
  tipo: 'combo';
}

type Producto = ProductoIndividual | ProductoCombo;

interface CategoriaProductos {
  categoria: string;
  items: Producto[];
}

const productos: CategoriaProductos[] = [
  {
    categoria: "Individuales",
    items: [
      { id: 1, nombre: "Perro Caliente", precio: 12000, imagen: "/images/perro.webp", tipo: 'individual' },
      { id: 2, nombre: "Palomitas Grandes", precio: 10000, imagen: "/images/palomitas.webp", tipo: 'individual' },
      { id: 3, nombre: "Gaseosa 500ml", precio: 5000, imagen: "/images/gaseosa.webp", tipo: 'individual' },
      { id: 4, nombre: "Chocolatina", precio: 3500, imagen: "/images/chocolatina.webp", tipo: 'individual' }
    ]
  },
  {
    categoria: "Combos",
    items: [
      { 
        id: 5, 
        nombre: "Combo Clásico", 
        precio: 20000,
        descripcion: "1 Perro + Palomitas Medianas + Gaseosa",
        tipo: 'combo'
      },
      { 
        id: 6, 
        nombre: "Combo Pareja", 
        precio: 35000,
        descripcion: "2 Perros + Palomitas Grandes + 2 Gaseosas",
        tipo: 'combo'
      },
      { 
        id: 7, 
        nombre: "Combo Familiar", 
        precio: 45000,
        descripcion: "3 Perros + Palomitas Gigantes + 3 Gaseosas + 2 Chocolatinas",
        tipo: 'combo'
      }
    ]
  }
];
---

<div class="max-w-4xl mx-auto p-6 bg-black rounded-xl shadow-xl border border-gray-800">
  <h2 class="text-3xl font-bold text-center mb-8 text-amber-400 border-b border-red-800 pb-4">
    Confitería Cinematográfica
  </h2>

  <div class="overflow-x-auto mb-12">
    <table class="w-full border-collapse">
      <thead>
        <tr class="bg-red-800 text-white">
          <th class="p-4 text-left">Producto</th>
          <th class="p-4 text-left">Descripción</th>
          <th class="p-4 text-right">Precio</th>
          <th class="p-4 text-center">Acción</th>
        </tr>
      </thead>
      <tbody>
        {productos.map(grupo => (
          <>
            <!-- Encabezado de Categoría -->
            <tr class="bg-gray-900">
              <td colspan="4" class="p-3 text-xl font-bold text-amber-400">
                {grupo.categoria}
              </td>
            </tr>
            
            <!-- Lista de Productos -->
            {grupo.items.map(producto => (
              <tr class="border-b border-gray-700 hover:bg-gray-800/50 transition-colors">
                <td class="p-4 text-white font-medium">{producto.nombre}</td>
                <td class="p-4 text-gray-300">
                  {producto.tipo === 'combo' ? producto.descripcion : "Producto individual"}
                </td>
                <td class="p-4 text-right text-amber-400">
                  ${producto.precio.toLocaleString('es-CO')}
                </td>
                <td class="p-4 text-center">
                  <button 
                    class="bg-amber-500 hover:bg-amber-600 text-black px-4 py-2 rounded-lg font-medium transition-colors"
                    data-id={producto.id}
                    data-nombre={producto.nombre}
                    data-precio={producto.precio}
                  >
                    Añadir
                  </button>
                </td>
              </tr>
            ))}
          </>
        ))}
      </tbody>
    </table>
  </div>

  <div class="bg-gray-900 p-6 rounded-lg border border-gray-700" id="carrito">
    <h3 class="text-2xl font-bold mb-4 text-amber-400 border-b border-red-800 pb-2">
      Tu Pedido
    </h3>
    
    <p class="text-gray-400 italic" id="carrito-vacio">Tu carrito está vacío</p>
    
    <div id="carrito-items" class="hidden">
      <div class="overflow-x-auto mb-6">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-gray-800 text-white">
              <th class="p-3 text-left">Producto</th>
              <th class="p-3 text-right">Precio</th>
            </tr>
          </thead>
          <tbody id="carrito-body"></tbody>
          <tfoot>
            <tr class="bg-gray-800 text-white">
              <td class="p-3 text-left font-bold">Total</td>
              <td class="p-3 text-right font-bold text-amber-400" id="carrito-total">
                $0
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
      
      <button 
        class="w-full bg-red-700 hover:bg-red-600 text-white py-3 px-6 rounded-lg font-bold transition-colors"
        id="confirmar-compra"
      >
        Confirmar Compra - $0
      </button>
    </div>
  </div>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const carrito = [];
  let total = 0;
  
  const carritoBody = document.getElementById('carrito-body');
  const carritoTotal = document.getElementById('carrito-total');
  const carritoSection = document.getElementById('carrito-items');
  const carritoVacio = document.getElementById('carrito-vacio');
  const confirmarBtn = document.getElementById('confirmar-compra');
  
  document.querySelectorAll('[data-id]').forEach(button => {
    button.addEventListener('click', () => {
      const producto = {
        id: button.getAttribute('data-id'),
        nombre: button.getAttribute('data-nombre'),
        precio: parseInt(button.getAttribute('data-precio'))
      };
      
      carrito.push(producto);
      total += producto.precio;
      actualizarCarrito();
    });
  });
  
  confirmarBtn.addEventListener('click', () => {
    alert(`¡Pedido confirmado por $${total.toLocaleString('es-CO')}!\nGracias por tu compra.`);
    carrito.length = 0;
    total = 0;
    actualizarCarrito();
  });
  
  function actualizarCarrito() {
    carritoBody.innerHTML = '';
    
    if (carrito.length > 0) {
      carritoVacio.classList.add('hidden');
      carritoSection.classList.remove('hidden');
      
      carrito.forEach(item => {
        const row = document.createElement('tr');
        row.className = 'border-b border-gray-700';
        row.innerHTML = `
          <td class="p-3 text-white">${item.nombre}</td>
          <td class="p-3 text-right text-amber-400">$${item.precio.toLocaleString('es-CO')}</td>
        `;
        carritoBody.appendChild(row);
      });
      
      carritoTotal.textContent = `$${total.toLocaleString('es-CO')}`;
      confirmarBtn.textContent = `Confirmar Compra - $${total.toLocaleString('es-CO')}`;
    } else {
      carritoVacio.classList.remove('hidden');
      carritoSection.classList.add('hidden');
    }
  }
});
</script>

<style>
img {
  max-width: 60px;
  border-radius: 4px;
  object-fit: cover;
}

button[data-id] {
  min-width: 100px;
}

#carrito-items {
  transition: all 0.3s ease;
}
</style>