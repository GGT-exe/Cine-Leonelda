---
// Props: message (string), show (boolean)
const { message = '', show = false } = Astro.props;
---

<!-- Contenedor de errores con animación -->
<div 
  id="auth-error"
  class={`mb-4 p-3 rounded-md border transition-all duration-300 ${show ? 'bg-red-900/50 border-red-600' : 'bg-transparent border-transparent h-0 opacity-0 p-0'}`}
>
  <p class="text-red-200 text-sm">
    {message}
    
    <!-- Slot para contenido adicional -->
    <slot />
  </p>
</div>

<script is:inline>
// Sistema de eventos para mostrar errores desde otros componentes
document.addEventListener('DOMContentLoaded', () => {
  document.addEventListener('auth-error', (e) => {
    const errorElement = document.getElementById('auth-error');
    const messageElement = errorElement.querySelector('p');
    
    messageElement.innerHTML = e.detail.message;
    errorElement.classList.remove('bg-transparent', 'border-transparent', 'h-0', 'opacity-0', 'p-0');
    errorElement.classList.add('bg-red-900/50', 'border-red-600');
    
    // Ocultar después de 5 segundos
    setTimeout(() => {
      errorElement.classList.add('bg-transparent', 'border-transparent', 'h-0', 'opacity-0', 'p-0');
    }, 5000);
  });
});
</script>