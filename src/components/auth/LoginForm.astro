
<html class="h-full bg-black">

<body class="h-full">
<div class="flex min-h-screen bg-black">
  <!-- Columna izquierda (logo) - Reducido padding vertical -->
  <div class="hidden md:flex w-1/2 items-center justify-center bg-black py-8 h-screen">
    <img class="h-auto max-w-md" src="IMG/logoCineLeonelda.png" alt="Cine Leonelda">
  </div>

  <!-- Columna derecha (formulario) - Reducido padding vertical -->
  <div class="w-full md:w-1/2 px-6 py-8 lg:px-8 flex flex-col justify-center h-screen">
    <div class="sm:mx-auto sm:w-full sm:max-w-sm bg-gray-900/70 p-8 rounded-xl border-2 border-red-600/70 shadow-2xl shadow-red-900/30">
      <!-- Logo en móviles más compacto -->
      <img class="mx-auto h-16 w-auto md:hidden mb-4" src="IMG/logoCineLeonelda.png" alt="Cine Leonelda">
      
      <!-- Título con menos margen superior -->
      <h2 class="text-center text-3xl font-bold text-red-500 mb-6">Inicia sesión en tu cuenta</h2>

      <!-- Mensaje de error más compacto -->
      <div id="auth-error" class="hidden mb-3 p-3 bg-red-900/50 text-red-200 rounded-md border border-red-600">
        <p id="error-message"></p>
      </div>

      <!-- Formulario con menos espacio entre elementos -->
      <form class="space-y-4" id="loginForm">
        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Correo electrónico</label>
          <input
            type="email"
            id="email"
            required
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
          >
        </div>

        <!-- Contraseña -->
        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="password" class="block text-sm font-medium text-gray-300">Contraseña</label>
            <a href="#" class="text-xs text-red-400 hover:text-red-300 hover:underline transition-colors">¿Olvidó su contraseña?</a>
          </div>
          <input
            type="password"
            id="password"
            required
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200"
          >
        </div>

        <!-- Botón de submit -->
        <div class="pt-1">
          <button
            type="submit"
            class="w-full bg-red-600 hover:bg-red-700 text-white py-3 px-4 rounded-lg font-medium shadow-lg shadow-red-900/30 hover:shadow-red-900/40 transition-all duration-300 transform hover:scale-[1.02]"
          >
            Iniciar sesión
          </button>
        </div>
      </form>

      <!-- Enlace a registro con menos margen superior -->
      <div class="mt-6 text-center">
        <p class="text-sm text-gray-400">
          ¿No tiene una cuenta? 
          <a href="/crearcuenta" class="font-medium text-red-400 hover:text-red-300 hover:underline transition-colors">
            Regístrese aquí
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const loginForm = document.getElementById('loginForm');
  const authError = document.getElementById('auth-error');
  const errorMessage = document.getElementById('error-message');

  loginForm.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    const usuariosRegistrados = JSON.parse(localStorage.getItem('usuarios') || '[]');
    const usuarioExistente = usuariosRegistrados.find(user => user.email === email);

    if (!usuarioExistente) {
      showError('El correo no está registrado. ¿Desea <a href="/crearcuenta?email=' + 
               encodeURIComponent(email) + '" class="font-semibold underline">crear una cuenta</a>?');
      return;
    }

    if (usuarioExistente.password !== password) {
      showError('Contraseña incorrecta. Intente nuevamente.');
      return;
    }

    // Cambio clave: Usar 'usuarioActual' en lugar de 'usuario'
    const userData = {
      email: usuarioExistente.email,
      name: usuarioExistente.name,
      isLoggedIn: true
    };
    
    localStorage.setItem('usuarioActual', JSON.stringify(userData));
    
    // Disparar evento personalizado para notificar el login
    document.dispatchEvent(new CustomEvent('userLoggedIn', {
      detail: userData
    }));

    // Redirección con parámetro
    const urlParams = new URLSearchParams(window.location.search);
    const redirectUrl = urlParams.get('redirect') || '/';
    window.location.href = `${redirectUrl}?fromLogin=true`;
  });

  function showError(message) {
    errorMessage.innerHTML = message;
    authError.classList.remove('hidden');
    
    setTimeout(() => {
      authError.classList.add('hidden');
    }, 5000);
  }
});
</script>