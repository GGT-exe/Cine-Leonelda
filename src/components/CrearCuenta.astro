---
// Component Script (Parte superior del archivo .astro)
const handleSubmit = (event) => {
  event.preventDefault();
  const form = event.target;
  const password = form.password.value;
  const confirmPassword = form.confirmPassword.value;

  if (password !== confirmPassword) {
    // Mostrar error en la UI
    const errorElement = document.getElementById('password-error');
    errorElement.classList.remove('hidden');
    return;
  }
  
  // Si todo está bien, enviar el formulario
  form.submit();
};
---

<div class="flex min-h-screen bg-black">
  <!-- Columna izquierda -->
  <div class="hidden md:flex w-1/2 items-center justify-center bg-black p-12 h-screen">
    <img 
      class="h-auto max-w-full max-h-screen" 
      src="IMG/logoCineLeonelda.png" 
      alt="Cine Leonelda"
    >
  </div>

  <!-- Columna derecha -->
  <div class="w-full md:w-1/2 px-6 py-12 lg:px-8 flex flex-col justify-center h-screen">
    <div class="sm:mx-auto sm:w-full sm:max-w-sm">
      <img class="mx-auto h-20 w-auto md:hidden" src="/public/logoCineLeonelda.png" alt="Cine Leonelda">
      <h2 class="mt-10 text-center text-2xl font-bold tracking-tight text-red-600">Crea una cuenta</h2>
    </div>

    <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
      <form class="space-y-6" on:submit={handleSubmit}>
        <div>
          <label for="name" class="block text-sm font-medium text-gray-500">Nombre completo</label>
          <div class="mt-2">
            <input 
              type="text" 
              name="name" 
              required 
              class="block w-full rounded-md bg-white px-3 py-1.5 text-gray-900 outline-1 outline-gray-300 focus:outline-2 focus:outline-red-500"
            >
          </div>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-gray-500">Correo electrónico</label>
          <div class="mt-2">
            <input 
              type="email" 
              name="email" 
              required 
              class="block w-full rounded-md bg-white px-3 py-1.5 text-gray-900 outline-1 outline-gray-300 focus:outline-2 focus:outline-red-500"
            >
          </div>
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-gray-500">Contraseña</label>
          <div class="mt-2">
            <input 
              type="password" 
              name="password" 
              id="password"
              required
              minlength="8"
              class="block w-full rounded-md bg-white px-3 py-1.5 text-gray-900 outline-1 outline-gray-300 focus:outline-2 focus:outline-red-500"
            >
          </div>
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-gray-500">Confirmar contraseña</label>
          <div class="mt-2">
            <input 
              type="password" 
              name="confirmPassword" 
              id="confirmPassword"
              required
              class="block w-full rounded-md bg-white px-3 py-1.5 text-gray-900 outline-1 outline-gray-300 focus:outline-2 focus:outline-red-500"
            >
            <p id="password-error" class="hidden text-red-500 text-sm mt-1">Las contraseñas no coinciden</p>
          </div>
        </div>

        <div>
          <button 
            type="submit"
            class="w-full flex justify-center rounded-md bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-500"
          >
            Crear cuenta
          </button>
        </div>
      </form>

      <p class="mt-10 text-center text-sm text-gray-500">
        ¿Ya tienes cuenta? 
        <a href="/iniciarsesion" class="font-semibold text-red-600 hover:text-red-500">Inicia sesión</a>
      </p>
    </div>
  </div>
</div>

<script is:inline>
// Script para validación en tiempo real
document.addEventListener('DOMContentLoaded', () => {
  const passwordInput = document.getElementById('password');
  const confirmPasswordInput = document.getElementById('confirmPassword');
  const errorElement = document.getElementById('password-error');

  confirmPasswordInput.addEventListener('input', () => {
    if (passwordInput.value !== confirmPasswordInput.value) {
      errorElement.classList.remove('hidden');
    } else {
      errorElement.classList.add('hidden');
    }
  });
});
</script>
