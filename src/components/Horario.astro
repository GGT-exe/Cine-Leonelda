---
export interface Props {
  title: string;
  image: string;
  info: string;
  class?: string;
}

const { title, image, info, class: className } = Astro.props;
---

<div class={`bg-gradient-to-br from-gray-900 to-gray-800 rounded-2xl overflow-hidden shadow-2xl ${className}`}>
  <div class="relative">
    <img 
      src={image} 
      alt={`Poster de ${title}`} 
      class="w-full h-96 object-cover opacity-90"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>
    <h1 class="absolute bottom-8 left-8 text-5xl font-extrabold text-white drop-shadow-2xl">
      {title}
    </h1>
  </div>
  
  <div class="p-8">
    <p class="text-gray-300 text-lg mb-6 leading-relaxed">{info}</p>
    <div class="flex items-center space-x-4">
      <span class="px-4 py-2 bg-blue-600 rounded-full text-sm font-semibold">NUEVO ESTRENO</span>
      <span class="text-yellow-400">★ ★ ★ ★ ☆</span>
    </div>
  </div>
</div>