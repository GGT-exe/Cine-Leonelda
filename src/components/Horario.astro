---
export interface Props {
  title: string;
  image: string;
  info: string;
  class?: string;
}

const { title, image, info, class: className } = Astro.props;
---

<div class={`flex flex-col md:flex-row gap-8 items-center ${className}`}>
  <img 
    src={image} 
    alt={`Poster de ${title}`} 
    class="w-full md:w-1/3 rounded-xl shadow-lg border-2 border-amber-400 hover:scale-105 transition-transform"
    loading="lazy"
  />
  <div class="flex-1">
    <h1 class="text-4xl font-bold mb-4 text-amber-400">{title}</h1>
    <p class="text-gray-300 text-lg leading-relaxed">{info}</p>
  </div>
</div>