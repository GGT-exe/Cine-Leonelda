<div class="bg-black">
  <header class="sticky top-0 z-50 bg-black/80 backdrop-blur-sm border-b-2 border-solid border-red-600">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between py-4">
        <!-- Logo y título -->
        <div class="flex items-center space-x-2">
          <img
            class="h-10 w-auto"
            src="IMG/logoCineLeonelda.png"
            alt="Cine Leonelda"
          />
          <h1 class="text-3xl font-bold text-red-600 hover:text-red-500 transition-colors ml-10">
            CINE LEONELDA
          </h1>
        </div>

        <!-- Navegación en pantallas grandes -->
        <nav class="hidden lg:flex items-center space-x-8">
          <a href="/" class="text-lg font-medium text-gray-300 hover:text-white transition-colors px-3 py-2 rounded-md">Inicio</a>
          <a href="/cartelera" class="text-lg font-medium text-gray-300 hover:text-white transition-colors px-3 py-2 rounded-md">Cartelera</a>
          <a href="/confiteria" class="text-lg font-medium text-gray-300 hover:text-white transition-colors px-3 py-2 rounded-md">Confitería</a>
          <a href="/nosotros" class="text-lg font-medium text-gray-300 hover:text-white transition-colors px-3 py-2 rounded-md">Sobre Nosotros</a>
          <a href="/compra" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-full font-medium transition-colors">Comprar Entradas</a>
          
          <!-- Menú de usuario (Desktop) -->
          <div class="relative" id="userMenuDesktop">
            <button id="userButtonDesktop" class="flex items-center text-gray-300 hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </button>

            <!-- Menú desplegable -->
            <div id="dropdownMenuDesktop" class="hidden absolute right-0 mt-2 w-48 bg-black rounded-md shadow-lg border border-red-600 z-50">
              <!-- Contenido dinámico se llenará con JavaScript -->
            </div>
          </div>
        </nav>

        <!-- Botón hamburguesa en móviles -->
        <div class="lg:hidden">
          <button
            id="menu-toggle"
            type="button"
            class="inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-700 hover:text-white focus:outline-none"
          >
            <span class="sr-only">Abrir menú</span>

            <!-- Ícono de hamburguesa -->
            <svg
              id="icon-menu"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
              />
            </svg>

            <!-- Ícono de cerrar -->
            <svg
              id="icon-close"
              class="h-6 w-6 hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Menú móvil oculto por defecto -->
    <div class="lg:hidden hidden" id="mobile-menu">
      <div class="space-y-1 px-2 pb-3 pt-2">
        <a href="/" class="block rounded-md px-3 py-2 text-base font-medium text-gray-300 hover:bg-gray-700 hover:text-white">Inicio</a>
        <a href="/cartelera" class="block rounded-md px-3 py-2 text-base font-medium text-gray-300 hover:bg-gray-700 hover:text-white">Cartelera</a>
        <a href="/confiteria" class="block rounded-md px-3 py-2 text-base font-medium text-gray-300 hover:bg-gray-700 hover:text-white">Confitería</a>
        <a href="/nosotros" class="block rounded-md px-3 py-2 text-base font-medium text-gray-300 hover:bg-gray-700 hover:text-white">Sobre Nosotros</a>
        <a href="/compra" class="block w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-center font-medium mt-2">Comprar Entradas</a>
        
        <!-- Menú de usuario (Mobile) -->
        <div id="userMenuMobile" class="block w-full">
          <!-- Contenido dinámico se llenará con JavaScript -->
        </div>
      </div>
    </div>
  </header>
</div>

<!-- Script para toggle del menú y funcionalidad de usuario -->
<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  // Toggle del menú móvil
  const toggleButton = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (toggleButton) {
    toggleButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  // Funcionalidad del menú de usuario
  const userData = JSON.parse(localStorage.getItem('usuario') || 'null');
  
  // Elementos del menú desktop
  const userButtonDesktop = document.getElementById('userButtonDesktop');
  const dropdownMenuDesktop = document.getElementById('dropdownMenuDesktop');
  
  // Elementos del menú mobile
  const userMenuMobile = document.getElementById('userMenuMobile');

  // Función para actualizar la UI según el estado de autenticación
  function updateAuthUI() {
    if (userData?.isLoggedIn) {
      // Menú desktop
      if (dropdownMenuDesktop) {
        dropdownMenuDesktop.innerHTML = `
          <div class="px-4 py-3 border-b border-red-600">
            <p class="text-sm text-white">Hola, ${userData.name || 'Usuario'}</p>
            <p class="text-xs text-gray-400">${userData.email || ''}</p>
          </div>
          <a href="#" class="block px-4 py-2 text-sm text-white hover:bg-red-600">Configuración</a>
          <button id="logoutButtonDesktop" class="w-full text-left px-4 py-2 text-sm text-white hover:bg-red-600">
            Cerrar sesión
          </button>
        `;
      }

      // Menú mobile
      if (userMenuMobile) {
        userMenuMobile.innerHTML = `
          <div class="px-4 py-3 border-b border-red-600 text-white text-center">
            <p class="text-sm">Hola, ${userData.name || 'Usuario'}</p>
          </div>
          <a href="#" class="block px-4 py-2 text-sm text-white hover:bg-red-600 text-center">Configuración</a>
          <button id="logoutButtonMobile" class="w-full px-4 py-2 text-sm text-white hover:bg-red-600 text-center">
            Cerrar sesión
          </button>
        `;
      }
    } else {
      // Menú desktop (mostrar opciones de inicio de sesión)
      if (dropdownMenuDesktop) {
        dropdownMenuDesktop.innerHTML = `
          <a href="/iniciarsesion" class="block px-4 py-2 text-sm text-white hover:bg-red-600">Iniciar sesión</a>
          <a href="/crearcuenta" class="block px-4 py-2 text-sm text-white hover:bg-red-600">Crear cuenta</a>
        `;
      }

      // Menú mobile (mostrar botón de inicio de sesión)
      if (userMenuMobile) {
        userMenuMobile.innerHTML = `
          <a href="/iniciarsesion" class="block w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-center font-medium mt-2">
            Iniciar sesión
          </a>
        `;
      }
    }
  }

  // Inicializar la UI
  updateAuthUI();

  // Manejar clic en el botón de usuario (desktop)
  if (userButtonDesktop && dropdownMenuDesktop) {
    userButtonDesktop.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdownMenuDesktop.classList.toggle('hidden');
    });
  }

  // Cerrar menú al hacer clic fuera (desktop)
  document.addEventListener('click', () => {
    if (dropdownMenuDesktop && !dropdownMenuDesktop.classList.contains('hidden')) {
      dropdownMenuDesktop.classList.add('hidden');
    }
  });

  // Manejar logout (desktop y mobile)
  document.addEventListener('click', (e) => {
    if (e.target.id === 'logoutButtonDesktop' || e.target.id === 'logoutButtonMobile') {
      localStorage.removeItem('usuario');
      window.location.href = '/';
    }
  });

  // Actualizar UI cuando cambia el estado de autenticación (por si se loguea en otra pestaña)
  window.addEventListener('storage', () => {
    const newUserData = JSON.parse(localStorage.getItem('usuario') || 'null');
    if (JSON.stringify(userData) !== JSON.stringify(newUserData)) {
      window.location.reload();
    }
  });
});
</script>