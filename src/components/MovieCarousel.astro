---
import { movies } from '../data/movies';
import Horario from './Horario.astro';
import HorarioTabla from './HorarioTabla.astro';
---

<div class="relative w-full" id="movieCarousel">
  <!-- Contenedor principal del carrusel -->
  <div class="overflow-hidden">
    <div class="flex transition-transform duration-500 ease-out" id="carouselContainer">
      {movies.map((movie) => (
        <div class="w-full flex-shrink-0">
          <!-- Reproductor de YouTube -->
          <div class="w-full aspect-video bg-black relative">
            <iframe 
              width="100%" 
              height="100%" 
              src={`https://www.youtube.com/embed/${movie.youtubeId}?autoplay=0&controls=1`}
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
              class="absolute top-0 left-0 w-full h-full"
            ></iframe>
            <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black to-transparent"></div>
          </div>

          <!-- Contenido debajo del video -->
          <div class="mx-auto w-full max-w-6xl px-4 py-12 bg-black">
            <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8">
              <!-- Sección de sinopsis -->
              <div class="bg-gray-900/20 p-8 rounded-xl border border-red-600/50">
                <div class="flex items-center mb-6">
                  <span class="px-4 py-2 bg-red-800 rounded-md text-sm text-white mr-4">NUEVO ESTRENO</span>
                  <div class="flex text-yellow-400 text-xl">
                    ★ ★ ★ ★ ☆
                  </div>
                </div>
                <h1 class="text-5xl font-bold mb-8 text-white">{movie.title}</h1>
                <p class="text-gray-100 text-xl leading-relaxed">{movie.info}</p>

                <!-- Comentarios y votación -->
                <div class="mt-10">
                  <h3 class="text-2xl font-semibold text-white mb-4">Deja tu comentario</h3>

                  <!-- Votación por estrellas -->
                  <div class="flex items-center gap-1 mb-4 text-yellow-400 text-2xl cursor-pointer" data-rating="0" id={`rating-${movie.id}`}>
                    {[1, 2, 3, 4, 5].map(i => (
                      <span 
                        class="hover:scale-125 transition-transform star"
                        data-value={i}
                        data-movieid={movie.id}
                      >
                        ★
                      </span>
                    ))}
                  </div>

                  <!-- Campo de texto para comentario -->
                  <textarea 
                    class="w-full p-4 rounded-lg bg-gray-800 text-white border border-gray-600 focus:outline-none focus:ring-2 focus:ring-red-500"
                    rows="4"
                    placeholder="Escribe tu opinión sobre la película..."
                  ></textarea>

                  <!-- Botón de enviar -->
                  <button 
                    class="mt-4 px-6 py-3 bg-red-700 hover:bg-red-800 text-white rounded-lg font-semibold transition-colors"
                  >
                    Enviar comentario
                  </button>
                </div>
              </div>

              <!-- Sección de horarios -->
              <div class="bg-gray-900/20 p-8 rounded-xl border border-red-600/50">
                <h2 class="text-4xl font-bold mb-8 text-white">Horarios</h2>
                <div class="mb-8">
                  <HorarioTabla movieData={movie.schedule} />
                </div>
                
                <div class="flex justify-center">
                  <button 
                    class="px-10 py-4 bg-gradient-to-r from-amber-600 to-amber-800 rounded-full font-bold hover:scale-105 transition-transform text-lg boton-asientos"
                    data-peliculaid={movie.id}
                  >
                    Comprar Entradas
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  {movies.length > 1 && (
    <>
      <!-- Botones de navegación flotantes -->
      <button 
        class="fixed left-4 transition-all duration-300 bg-black/80 hover:bg-amber-700 text-white p-3 rounded-full z-50 shadow-lg hover:scale-110"
        id="prevButton"
        aria-label="Película anterior"
        style="top: 50vh"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button 
        class="fixed right-4 transition-all duration-300 bg-black/80 hover:bg-amber-700 text-white p-3 rounded-full z-50 shadow-lg hover:scale-110"
        id="nextButton"
        aria-label="Siguiente película"
        style="top: 50vh"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Indicadores -->
      <div class="flex justify-center gap-4 mt-8 pb-8" id="indicators">
        {movies.map((_, index) => (
          <button 
            class={`w-10 h-2 rounded-full transition-all ${index === 0 ? 'bg-amber-500' : 'bg-gray-600'}`}
            data-index={index}
            aria-label={`Ir a película ${index + 1}`}
          />
        ))}
      </div>
    </>
  )}
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('carouselContainer');
  const prevBtn = document.getElementById('prevButton');
  const nextBtn = document.getElementById('nextButton');
  const indicators = document.querySelectorAll('#indicators button');
  
  let currentIndex = 0;
  const totalMovies = document.querySelectorAll('#carouselContainer > div').length;

  // Carrusel
  function updateArrowPosition() {
    const scrollPosition = window.scrollY;
    const windowHeight = window.innerHeight;
    const videoHeight = document.querySelector('iframe')?.offsetHeight || 0;
    const maxScroll = document.body.scrollHeight - windowHeight;
    const newPosition = Math.min(scrollPosition + (windowHeight / 2), maxScroll);
    if (scrollPosition > videoHeight * 0.7) {
      prevBtn.style.top = `${newPosition}px`;
      nextBtn.style.top = `${newPosition}px`;
    } else {
      prevBtn.style.top = `${videoHeight * 0.5}px`;
      nextBtn.style.top = `${videoHeight * 0.5}px`;
    }
  }

  function updateCarousel() {
    container.style.transform = `translateX(-${currentIndex * 100}%)`;
    indicators.forEach((indicator, i) => {
      indicator.classList.toggle('bg-amber-500', i === currentIndex);
      indicator.classList.toggle('bg-gray-600', i !== currentIndex);
      indicator.classList.toggle('w-10', i === currentIndex);
      indicator.classList.toggle('w-6', i !== currentIndex);
    });
  }

  if (totalMovies > 1) {
    window.addEventListener('scroll', updateArrowPosition);
    prevBtn.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + totalMovies) % totalMovies;
      updateCarousel();
    });
    nextBtn.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % totalMovies;
      updateCarousel();
    });
    indicators.forEach(indicator => {
      indicator.addEventListener('click', () => {
        currentIndex = parseInt(indicator.dataset.index);
        updateCarousel();
      });
    });
  }

  updateCarousel();
  updateArrowPosition();

  // Calificación por estrellas
  document.querySelectorAll('.star').forEach(star => {
    star.addEventListener('click', () => {
      const movieId = star.dataset.movieid;
      const rating = parseInt(star.dataset.value);
      const container = document.getElementById(`rating-${movieId}`);
      container.dataset.rating = rating;

      container.querySelectorAll('.star').forEach(s => {
        const val = parseInt(s.dataset.value);
        s.style.color = val <= rating ? '#facc15' : '#555';
      });
    });
  });
});
</script>
