---
export interface Props {
  movieData: {
    days: Record<
      string,
      {
        times: string[];
        duration: string;
        rating: string;
      }
    >;
  };
}

const { movieData } = Astro.props;
const daysOrder = [
  "Lunes",
  "Martes",
  "Miércoles",
  "Jueves",
  "Viernes",
  "Sábado",
  "Domingo",
];
---

<div class="space-y-4">
  <!-- Tabla compacta con encabezados -->
  <table class="w-full border-separate border-spacing-0 mb-4">
    <thead>
      <tr class="bg-red-800 text-white">
        <th class="p-2 font-bold border-b border-gray-700 text-sm">Día</th>
        <th class="p-2 font-bold border-b border-gray-700 text-sm">Duración</th>
        <th class="p-2 font-bold border-b border-gray-700 text-sm">Clasificación</th>
      </tr>
    </thead>
  </table>

  <!-- Lista de días y horarios -->
  <div class="space-y-2">
    {daysOrder.map((day) => {
      const dayData = movieData.days[day] || {
        times: [],
        duration: "",
        rating: "",
      };

      return (
        <div class="bg-gray-900/50 rounded-lg p-3 hover:bg-gray-700/50 transition-colors">
          <div class="flex flex-col md:flex-row md:items-center gap-3">
            <div class="w-20 flex-shrink-0">
              <h3 class="text-md font-bold text-amber-400">{day}</h3>
              <p class="text-xs text-gray-400">{dayData.duration || "-"}</p>
            </div>
            
            <div class="flex-1">
              <div class="flex flex-wrap gap-1">
                {dayData.times.length > 0 ? (
                  dayData.times.map((time) => (
                    <button class="px-2 py-1 bg-gray-700 hover:bg-amber-500 rounded-md transition-colors text-gray-200 hover:text-white text-sm">
                      {time}
                    </button>
                  ))
                ) : (
                  <span class="text-gray-500 text-sm">No hay funciones</span>
                )}
              </div>
            </div>
            
            <div class="w-14 flex-shrink-0 text-center">
              <span class="inline-block px-2 py-1 bg-red-800 rounded-md text-xs text-white">
                {dayData.rating || "-"}
              </span>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>